{
  "name": "yudao-view",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Yudao 画面：Vite 构建的一组静态文件，由 Yudao 服务在服务地址下的 /view/ 按文件路径提供",
  "scripts": {
    "generate:api": "node scripts/generate-api.mjs",
    "build": "vite build",
