  },
  "dependencies": {
    "gsap": "3.13.0",
    "pixi.js": "8.13.1",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "@playwright/test": "1.63.0"
  }
}
