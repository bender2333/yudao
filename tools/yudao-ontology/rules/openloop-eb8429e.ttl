# 同一份设计说明在 eb8429e（用户手修以后）判开环与加载拒绝的几句话。
@prefix yd:   <https://yudao.dev/onto#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

yd:rule-47-4 a yd:OpenLoopRule ; rdfs:label "第 4.7 节第 4 条：按最后采纳的成果判开环"@zh ;
    yd:docPath "docs/design/forms-and-verifier-role.md" ;
    yd:quote "按冻结的定义看事项最后采纳的成果（直做下是交完成的那一份，成果驱动下是交付）有没有核验角色核验；没有，事项标为开环" ;
    yd:quote "标记说的是最后采纳的东西有没有经过独立核验" ;
    yd:axiomTurtle "yd:FinalNotVerified rdfs:subClassOf yd:OpenLoopMarked . yd:FinalVerified rdfs:subClassOf yd:NotOpenLoopMarked ." .

yd:rule-acc-12 a yd:OpenLoopRule ; rdfs:label "验收第 12 条（改写后）：按最后采纳的成果判开环"@zh ;
    yd:docPath "docs/design/forms-and-verifier-role.md" ;
    yd:quote "有核验角色、但它不核验事项最后采纳的那种成果（只核验中途的成果）时，事项创建时标为开环，以开环完成结束" ;
    yd:axiomTurtle "[ owl:intersectionOf ( yd:HasVerifier yd:FinalNotVerified ) ] rdfs:subClassOf yd:OpenLoopMarked ." .

# 加载拒绝。写成公理时用了一条推论：直做下只有指定的角色交完成（4.3 第 3 条「指定的角色交了完成」），
# 所以核验角色核验的若不是交完成的那个角色，被核验的角色就交不出完成。这条推论是本线程加的，报告里写明。
yd:rule-43-5 a yd:LoadRule ; rdfs:label "第 4.3 节第 5 条：被核验的角色交不出完成，加载时拒绝"@zh ;
    yd:docPath "docs/design/forms-and-verifier-role.md" ;
    yd:quote "核验角色要核验的角色必须交得出完成，交不出的定义在加载时整份拒绝" ;
    yd:axiomTurtle "[ owl:intersectionOf ( yd:HasVerifier yd:CompleterNotVerified ) ] rdfs:subClassOf yd:RejectedAtLoad ." .
