@prefix yd: <https://yudao.dev/onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# NOTE: yd:rm-direct is not defined in core/batch0; declared here as a RotationMode individual.
# UNSURE: dept-engineering and role IRIs: only yd:dept-engineering was given; role/form IRIs below are my own.
# UNSURE: 4.1 table is generic (中心角色/探索者/主程/审查者); 4.1 second table names 工程架构师 as engineering center role. Objective/evidence cells taken from the generic table.
# UNSURE: 主程 'can be' outsourced (可以是外包角色) -> typed yd:Role only, not OutsourcedRole.
# UNSURE: 审查者 hasIndependentEvidence omitted: 4.1 only lists tool '在独立副本上运行检查' generically (not stated as the engineering verification's evidence), so Run/OtherModel/Human not asserted; no hasCheckDefinition.
# UNSURE: 开环完成 outcome not mentioned for engineering sub-organization; no yd:completion-openloop outcome created.
# UNSURE: yd:produces for 主程 (实现代码), 审查者 (结论) omitted; text does not state what they hand in as an outcome kind (only tools/objective).
# UNSURE: yd:watches (关注的成果) not requested, omitted.
# MISSING-VOCAB: no property for 写入范围/可见范围/工具许可 (role scopes), 子事项层数上限 etc.
# MISSING-VOCAB: no property linking VerificationDecl to 'binding to content digest' (结论绑定内容摘要) or 'only 交完成 verdict ends sub-item'.
# MISSING-VOCAB: no property for 工作中途询问审查者 (mid-work draft review, 4.3), not modelled.
# MISSING-VOCAB: no property for 审查者 reading order (先判断再看解释), 4.4.

yd:rm-direct a yd:RotationMode ; rdfs:label "直做"@zh ;
  yd:docRef "4.3" ; yd:quote "子组织的路由就是直做，与其他形态用的是同一条直做路由，不另写" .

yd:src-subtask a yd:Source ; rdfs:label "上一层交来的任务"@zh ; yd:docRef "4.2" ;
  yd:quote "子事项的来源只有「上一层交来的任务」，由中心角色接。" .

yd:form-engineering-centered a yd:Form ; rdfs:label "工程的中心型小组"@zh ; yd:docRef "4.2, 4.3" ;
  yd:quote "部门的角色定义可以指向一份子组织形态，默认是中心型小组。" ;
  yd:rotation yd:rm-direct ;
  yd:canSubmitCompletion yd:role-eng-architect ;
  yd:finalOutcome yd:outcome-eng-completion .

yd:dept-engineering yd:subOrganization yd:form-engineering-centered ;
  yd:hasInternalVerification yd:decl-eng-review .

yd:outcome-eng-completion a yd:OutcomeKind ; rdfs:label "中心角色交的完成"@zh ; yd:docRef "4.3" ;
  yd:quote "中心角色交完成时，审查者作为核验角色核验中心角色交的这一版……放行则子事项结束；打回则中心角色再开始一轮。" ;
  yd:completion yd:completion-release .

yd:outcome-eng-finding a yd:OutcomeKind ; rdfs:label "带来源的发现"@zh ; yd:docRef "4.1" ;
  yd:quote "| 探索者 | 询问里交来的查证任务 | 交回带来源的发现 | 项目材料、代码、外部文档 | 本部门可见范围 | 只读，不写入 | 查询与读取、记录 | 否 |" .
# UNSURE: completion of 带来源的发现 not stated; left unset.

# ---- roles ----
yd:role-eng-architect a yd:Role ; rdfs:label "工程架构师（中心角色）"@zh ; yd:docRef "4.1" ;
  yd:quote "| 中心角色 | 上一层交来的任务与本部门的设计、计划或检查设计 | 把任务做成能交完成的成果 | 项目材料、同伴交回的结论、本部门记录 | 本部门可见范围 | 只写自己的设计、计划或检查设计草案 | …交完成 | 否 |；| 工程 | 工程架构师 | …" ;
  yd:inForm yd:form-engineering-centered ; yd:belongsTo yd:dept-engineering ;
  yd:hasObjective yd:obj-eng-architect ; yd:hasEvidenceBasis yd:evb-eng-architect ;
  yd:receives yd:src-subtask ; yd:produces yd:outcome-eng-completion .

yd:role-eng-explorer a yd:Role ; rdfs:label "探索者"@zh ; yd:docRef "4.1" ;
  yd:quote "| 探索者 | 询问里交来的查证任务 | 交回带来源的发现 | 项目材料、代码、外部文档 | 本部门可见范围 | 只读，不写入 | 查询与读取、记录 | 否 |；探索者读代码、查库与接口文档、复现问题" ;
  yd:inForm yd:form-engineering-centered ; yd:belongsTo yd:dept-engineering ;
  yd:hasObjective yd:obj-eng-explorer ; yd:hasEvidenceBasis yd:evb-eng-explorer ;
  yd:produces yd:outcome-eng-finding .

yd:role-eng-lead-dev a yd:Role ; rdfs:label "主程"@zh ; yd:docRef "4.1" ;
  yd:quote "| 主程 | 询问里交来的实现任务 | 按设计与计划实现并自测 | 设计与计划、代码、自测结果 | 本部门可见范围 | 工作区 | 读写工作区、运行命令与自测、记录 | 否 |；主程可以是外包角色" ;
  yd:inForm yd:form-engineering-centered ; yd:belongsTo yd:dept-engineering ;
  yd:hasObjective yd:obj-eng-lead-dev ; yd:hasEvidenceBasis yd:evb-eng-lead-dev .

yd:role-eng-reviewer a yd:Role, yd:NoAuthorHistory ; rdfs:label "审查者"@zh ; yd:docRef "4.1, 4.4" ;
  yd:quote "| 审查者 | 中心角色交的完成，工作中途交来的草案 | 判断这一版成果是否可以放行 | 待审查的成果、它的依据、上一轮审查意见 | 成果与依据，不含作者的历史 | 检查材料，不写工作区 | … | 是，核验中心角色交的完成 |；审查者每次从新的上下文开始……看不到作者的历史。" ;
  yd:inForm yd:form-engineering-centered ; yd:belongsTo yd:dept-engineering ;
  yd:hasObjective yd:obj-eng-reviewer ; yd:hasEvidenceBasis yd:evb-eng-reviewer .

# ---- objectives / evidence bases ----
yd:obj-eng-architect a yd:Objective ; rdfs:label "把任务做成能交完成的成果"@zh ; yd:docRef "4.1" ; yd:quote "4.1 角色清单表，中心角色行，目标列：把任务做成能交完成的成果" .
yd:evb-eng-architect a yd:EvidenceBasis ; rdfs:label "项目材料、同伴交回的结论、本部门记录"@zh ; yd:docRef "4.1" ; yd:quote "4.1 角色清单表，中心角色行，证据来源列：项目材料、同伴交回的结论、本部门记录" .
yd:obj-eng-explorer a yd:Objective ; rdfs:label "交回带来源的发现"@zh ; yd:docRef "4.1" ; yd:quote "4.1 角色清单表，探索者行，目标列：交回带来源的发现" .
yd:evb-eng-explorer a yd:EvidenceBasis ; rdfs:label "项目材料、代码、外部文档"@zh ; yd:docRef "4.1" ; yd:quote "4.1 角色清单表，探索者行，证据来源列：项目材料、代码、外部文档" .
yd:obj-eng-lead-dev a yd:Objective ; rdfs:label "按设计与计划实现并自测"@zh ; yd:docRef "4.1" ; yd:quote "4.1 角色清单表，主程行，目标列：按设计与计划实现并自测" .
yd:evb-eng-lead-dev a yd:EvidenceBasis ; rdfs:label "设计与计划、代码、自测结果"@zh ; yd:docRef "4.1" ; yd:quote "4.1 角色清单表，主程行，证据来源列：设计与计划、代码、自测结果" .
yd:obj-eng-reviewer a yd:Objective ; rdfs:label "判断这一版成果是否可以放行"@zh ; yd:docRef "4.1" ; yd:quote "4.1 角色清单表，审查者行，目标列：判断这一版成果是否可以放行" .
yd:evb-eng-reviewer a yd:EvidenceBasis ; rdfs:label "待审查的成果、它的依据、上一轮审查意见"@zh ; yd:docRef "4.1" ; yd:quote "4.1 角色清单表，审查者行，证据来源列：待审查的成果、它的依据、上一轮审查意见" .

yd:decl-eng-review a yd:VerificationDecl ; rdfs:label "审查者核验中心角色交的完成（工程）"@zh ; yd:docRef "4.1, 4.3" ;
  yd:quote "中心角色交完成时，审查者作为核验角色核验中心角色交的这一版：……工程审查设计与代码。" ;
  yd:verifier yd:role-eng-reviewer ; yd:verified yd:role-eng-architect ;
  yd:forOutcome yd:outcome-eng-completion ; yd:inForm yd:form-engineering-centered .
