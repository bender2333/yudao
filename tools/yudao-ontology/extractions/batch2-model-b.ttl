@prefix yd:   <https://yudao.dev/onto#> .
@prefix g:    <https://yudao.dev/onto-b2#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

g:form-center a yd:Form ;
    rdfs:label "中心型小组"@zh ;
    yd:archRef "4.2" ;
    yd:quote "职能的角色定义可以指向一份子组织形态，默认是中心型小组。" ;
    yd:rotation yd:rm-direct ;
    yd:canSubmitCompletion g:role-center .

# NOTE: rotation rm-direct from 子组织的路由就是直做 (4.3); canSubmitCompletion from 中心角色交完成时 (4.3)


g:src-upper-task a yd:Source ;
    rdfs:label "上一层交来的任务"@zh ;
    yd:archRef "4.2" ;
    yd:quote "子事项的来源只有「上一层交来的任务」，由中心角色接。" .

g:oc-design-plan a yd:OutcomeKind ;
    rdfs:label "设计、计划或检查设计草案"@zh ;
    yd:archRef "4.1" ;
    yd:quote "只写自己的设计、计划或检查设计草案" .

g:oc-completion a yd:OutcomeKind ;
    rdfs:label "中心角色交的完成"@zh ;
    yd:archRef "4.3" ;
    yd:quote "中心角色交完成时，审查者作为核验角色核验中心角色交的这一版" .

g:oc-lookup-task a yd:OutcomeKind ;
    rdfs:label "询问里交来的查证任务"@zh ;
    yd:archRef "4.1" ;
    yd:quote "询问里交来的查证任务" .

g:oc-impl-task a yd:OutcomeKind ;
    rdfs:label "询问里交来的实现任务"@zh ;
    yd:archRef "4.1" ;
    yd:quote "询问里交来的实现任务" .

g:oc-midway-draft a yd:OutcomeKind ;
    rdfs:label "工作中途交来的草案"@zh ;
    yd:archRef "4.1" ;
    yd:quote "中心角色交的完成，工作中途交来的草案" .

g:oc-finding a yd:OutcomeKind ;
    rdfs:label "带来源的发现"@zh ;
    yd:archRef "4.1" ;
    yd:quote "交回带来源的发现" .

g:oc-verdict a yd:OutcomeKind ;
    rdfs:label "审查者的结论"@zh ;
    yd:archRef "4.3" ;
    yd:quote "提交结论" .

# UNSURE: 查证任务 / 实现任务 are tasks handed in via 询问, not outcomes; modeled as OutcomeKind only because yd:watches needs one


# UNSURE: 审查者的结论 label is mine (text: 结论 / 审查意见); quote 提交结论 is from the 工具许可 cell


g:eb-center a yd:EvidenceBasis ;
    rdfs:label "项目材料、同伴交回的结论、本职能记录"@zh ;
    yd:archRef "4.1" ;
    yd:quote "项目材料、同伴交回的结论、本职能记录" .

g:obj-center a yd:Objective ;
    rdfs:label "把任务做成能交完成的成果"@zh ;
    yd:archRef "4.1" ;
    yd:quote "把任务做成能交完成的成果" .

g:eb-explorer a yd:EvidenceBasis ;
    rdfs:label "项目材料、代码、外部文档"@zh ;
    yd:archRef "4.1" ;
    yd:quote "项目材料、代码、外部文档" .

g:obj-explorer a yd:Objective ;
    rdfs:label "交回带来源的发现"@zh ;
    yd:archRef "4.1" ;
    yd:quote "交回带来源的发现" .

g:eb-lead a yd:EvidenceBasis ;
    rdfs:label "设计与计划、代码、自测结果"@zh ;
    yd:archRef "4.1" ;
    yd:quote "设计与计划、代码、自测结果" .

g:obj-lead a yd:Objective ;
    rdfs:label "按设计与计划实现并自测"@zh ;
    yd:archRef "4.1" ;
    yd:quote "按设计与计划实现并自测" .

g:eb-reviewer a yd:EvidenceBasis ;
    rdfs:label "待审查的成果、它的依据、上一轮审查意见"@zh ;
    yd:archRef "4.1" ;
    yd:quote "待审查的成果、它的依据、上一轮审查意见" .

g:obj-reviewer a yd:Objective ;
    rdfs:label "判断这一版成果是否可以放行"@zh ;
    yd:archRef "4.1" ;
    yd:quote "判断这一版成果是否可以放行" .

g:role-center a yd:Role ;
    rdfs:label "中心角色"@zh ;
    yd:archRef "4.1" ;
    yd:quote "子组织里的四个角色按定义缝的七个字段声明" ;
    yd:receives g:src-upper-task ;
    yd:watches g:oc-design-plan ;
    yd:produces g:oc-design-plan, g:oc-completion ;
    yd:inForm g:form-center ;
    yd:hasObjective g:obj-center ;
    yd:hasEvidenceBasis g:eb-center .

g:role-explorer a yd:Role ;
    rdfs:label "探索者"@zh ;
    yd:archRef "4.1" ;
    yd:quote "子组织里的四个角色按定义缝的七个字段声明" ;
    yd:watches g:oc-lookup-task ;
    yd:produces g:oc-finding ;
    yd:inForm g:form-center ;
    yd:hasObjective g:obj-explorer ;
    yd:hasEvidenceBasis g:eb-explorer .

g:role-lead a yd:Role ;
    rdfs:label "主程"@zh ;
    yd:archRef "4.1" ;
    yd:quote "子组织里的四个角色按定义缝的七个字段声明" ;
    yd:watches g:oc-impl-task ;
    yd:inForm g:form-center ;
    yd:hasObjective g:obj-lead ;
    yd:hasEvidenceBasis g:eb-lead .

g:role-reviewer a yd:Role ;
    rdfs:label "审查者"@zh ;
    yd:archRef "4.1" ;
    yd:quote "子组织里的四个角色按定义缝的七个字段声明" ;
    yd:watches g:oc-completion, g:oc-midway-draft ;
    yd:produces g:oc-verdict ;
    a yd:NoAuthorHistory ;
    yd:inForm g:form-center ;
    yd:hasObjective g:obj-reviewer ;
    yd:hasEvidenceBasis g:eb-reviewer .

# NOTE: all four role quotes are the 4.1 intro sentence (table rows are not sentences); per-role values come from the 4.1 table cells for 关注的成果 / 目标 / 证据来源


# UNSURE: 主程 produces nothing asserted (text gives objective 按设计与计划实现并自测 but names no output kind)


# UNSURE: 中心角色 produces oc-completion from 工具许可 cell 交完成 and 4.3 中心角色交完成时


# UNSURE: 中心角色 watches 本职能的设计、计划或检查设计 -> oc-design-plan; the 上一层交来的任务 part is modeled by yd:receives src-upper-task


# NOTE: 审查者 typed yd:NoAuthorHistory from 4.4 看不到作者的历史; the other roles' author-history property is not stated


# NOTE: roles 产品架构师 / 工程架构师 / 测试工程师 (the three 中心角色 in the second table) not minted: belongsTo for 产品 and 质检 would need IRIs this file does not own


g:vd-reviewer a yd:VerificationDecl ;
    rdfs:label "审查者核验中心角色交的完成"@zh ;
    yd:archRef "4.3" ;
    yd:quote "中心角色交完成时，审查者作为核验角色核验中心角色交的这一版" ;
    yd:verifier g:role-reviewer ;
    yd:verified g:role-center ;
    yd:forOutcome g:oc-completion ;
    yd:inForm g:form-center .

yd:dept-engineering yd:subOrganization g:form-center ; yd:hasInternalVerification g:vd-reviewer .


# NOTE: the line above attaches the 4.1 engineering row (三个职能同构 / 工程 row) to yd:dept-engineering; the text states the role split per function, and 默认是中心型小组 in 4.2


# NOTE: planned: nothing in 4.1-4.4 is marked 以后/还没有; 4.5 外层返工 has no body. 工程's 主程 may be an outsourced role (D31) and 审查者 not outsourced: no individual to attach, not modeled

