# 第 1 批（抽取 A）：从总图正文抽出的个体与属性值。只用 core.ttl 的类与属性，不加公理、不加类。
@prefix yd:   <https://yudao.dev/onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ======================= 开头一段：固定的结构 =======================

yd:fs-loop a yd:FixedStructure ;
    rdfs:label "循环"@zh ;
    yd:archRef "开头一段" ;
    yd:quote "固定不变的只有三样：循环、边界、裁决；职能、角色、轮转方式、核验角色、工作单元的大小都是填进去的内容。" .

yd:fs-boundary a yd:FixedStructure ;
    rdfs:label "边界"@zh ;
    yd:archRef "开头一段" ;
    yd:quote "固定不变的只有三样：循环、边界、裁决；职能、角色、轮转方式、核验角色、工作单元的大小都是填进去的内容。" ;
    yd:inRing yd:ring-approve-only .

yd:fs-adjudication a yd:FixedStructure ;
    rdfs:label "裁决"@zh ;
    yd:archRef "开头一段" ;
    yd:quote "固定不变的只有三样：循环、边界、裁决；职能、角色、轮转方式、核验角色、工作单元的大小都是填进去的内容。" ;
    yd:inRing yd:ring-approve-only .

# ======================= 第一节：职能、成果、形态、核验 =======================

yd:user a yd:User ;
    rdfs:label "你"@zh ;
    yd:archRef "第一节" ;
    yd:quote "你给意图与中途的指导，回答停在写入口的决定请求，批准内核与定义的修改。" ;
    yd:produces yd:ok-intent , yd:ok-guidance .

yd:dept-product a yd:Department ;
    rdfs:label "产品"@zh ;
    yd:archRef "第一节" ;
    yd:quote "产品意图 → 要求（PRD）。裁决目标与取舍。" ;
    yd:watches yd:ok-intent , yd:ok-guidance ;
    yd:produces yd:ok-requirement ;
    yd:inForm yd:form-default ;
    yd:mayAsk yd:dept-engineering , yd:dept-qa .

yd:dept-engineering a yd:Department ;
    rdfs:label "工程"@zh ;
    yd:archRef "第一节" ;
    yd:quote "工程要求 → 交付。写代码、自测、交快照。可以有自有角色或外包角色；一个职能的内部也可以是一个子组织。" ;
    yd:watches yd:ok-requirement , yd:ok-defect , yd:ok-guidance ;
    yd:produces yd:ok-delivery ;
    yd:mayAsk yd:dept-product , yd:dept-qa ;
    yd:notModeled "可以有自有角色或外包角色；一个职能的内部也可以是一个子组织（说的是可能，不是这个职能现在的子组织）" .
# UNSURE: 工程既在默认形态（产品 → 工程 → 质检）里，又是「最少」形态的唯一职能；yd:inForm 是函数型，只能填一个，所以没写 inForm。

yd:dept-qa a yd:Department ;
    rdfs:label "质检"@zh ;
    yd:archRef "第一节" ;
    yd:quote "质检交付 → 缺陷或放行。它是默认形态里的核验角色：有核验角色时只有它的结论能放行，这个结论不外包。" ;
    yd:watches yd:ok-delivery , yd:ok-guidance ;
    yd:produces yd:ok-defect ;
    yd:inForm yd:form-default ;
    yd:mayAsk yd:dept-product , yd:dept-engineering .
# NOTE: 「放行」不当成果种类，它是结束方式 yd:completion-release；总图没说哪种成果以放行结束（默认形态是放行，最少形态是开环完成），所以没写 yd:completion。

yd:dept-ops a yd:Department ;
    rdfs:label "运维"@zh ;
    yd:archRef "第一节" ;
    yd:quote "运维（以后）监控、部署、故障记录。" ;
    yd:planned true .

# ---------- 成果种类 ----------
yd:ok-intent a yd:OutcomeKind ;
    rdfs:label "意图"@zh ;
    yd:archRef "第一节" ;
    yd:quote "产品意图 → 要求（PRD）。……你给意图与中途的指导" .
# UNSURE: 「意图」也可能应当是事项的来源「你的输入」（yd:Source），而不是成果种类；按「输入 → 产出」的箭头写成产品关注的成果。

yd:ok-guidance a yd:OutcomeKind ;
    rdfs:label "指导"@zh ;
    yd:archRef "第三节" ;
    yd:quote "你中途的指导是职能关注的成果：职能在等待时，指导让它开始一轮；在一轮工作中时，指导在下一步作为通知加入。" .

yd:ok-requirement a yd:OutcomeKind ;
    rdfs:label "要求（PRD）"@zh ;
    yd:archRef "第一节" ;
    yd:quote "产品意图 → 要求（PRD）。" .

yd:ok-delivery a yd:OutcomeKind ;
    rdfs:label "交付"@zh ;
    yd:archRef "第一节" ;
    yd:quote "工程要求 → 交付。" .

yd:ok-defect a yd:OutcomeKind ;
    rdfs:label "缺陷"@zh ;
    yd:archRef "第一节" ;
    yd:quote "质检交付 → 缺陷或放行。……缺陷记录是上游关注的成果" .

# ---------- 职能之间的询问 ----------
yd:ask-between-departments a yd:Ask ;
    rdfs:label "职能之间的询问"@zh ;
    yd:archRef "第一节" ;
    yd:quote "职能之间的询问也在这里。……任何职能随时可以询问另一个职能" .

# ---------- 轮转方式 ----------
yd:rm-direct a yd:RotationMode ;
    rdfs:label "直做"@zh ;
    yd:archRef "第一节" ;
    yd:quote "直做：一个或几个角色靠询问协作，指定的角色交完成就结束。" .

yd:rm-by-outcome a yd:RotationMode ;
    rdfs:label "按成果"@zh ;
    yd:archRef "第一节" ;
    yd:quote "按成果：谁关注的成果有了新版本谁开工。" .
# UNSURE: 「直做按成果任务池（以后）」里的「（以后）」看起来只跟着任务池；按成果没标 planned。

yd:rm-task-pool a yd:RotationMode ;
    rdfs:label "任务池"@zh ;
    yd:archRef "第一节" ;
    yd:quote "任务池：发布、认领、完成、打回。" ;
    yd:planned true .

# ---------- 形态 ----------
yd:form-default a yd:Form ;
    rdfs:label "默认形态"@zh ;
    rdfs:comment "总图也叫它「产品 · 工程 · 质检」"@zh ;
    yd:archRef "第一节" ;
    yd:quote "默认：产品 → 工程 → 质检 → 放行或打回工程；任何职能随时可以询问另一个职能。" .
# UNSURE: 默认形态用哪种轮转方式，总图没写，未填 yd:rotation。

yd:form-minimal a yd:Form ;
    rdfs:label "最少"@zh ;
    yd:archRef "第一节" ;
    yd:quote "最少：只有工程一个职能，直做，交完成即开环完成" ;
    yd:rotation yd:rm-direct ;
    yd:canSubmitCompletion yd:dept-engineering .

yd:form-single-agent a yd:Form ;
    rdfs:label "单 agent"@zh ;
    yd:archRef "第二节「四层」" ;
    yd:quote "单 agent、普通多 agent、产品 · 工程 · 质检、子组织都只换下面两层，任何一种要改上面两层，就是抽象没立住。" .

yd:form-plain-multi-agent a yd:Form ;
    rdfs:label "普通多 agent"@zh ;
    yd:archRef "第二节「四层」" ;
    yd:quote "单 agent、普通多 agent、产品 · 工程 · 质检、子组织都只换下面两层，任何一种要改上面两层，就是抽象没立住。" .

yd:form-suborg a yd:Form ;
    rdfs:label "子组织"@zh ;
    yd:archRef "第三节" ;
    yd:quote "子组织：一个角色的一轮工作可以开一个子事项，子事项有自己的事件流、冻结的定义与边界，时间与用量从上一层剩下的里扣，层数有上限；结果作为这个角色的普通提案回到上一层，照常过裁决。职能内的多角色也用这一种做法。" .
# NOTE: 第二节「四层」那句里的「产品 · 工程 · 质检」当成 yd:form-default，没有另起个体。

# ---------- 核验声明 ----------
yd:vd-qa-engineering a yd:VerificationDecl ;
    rdfs:label "质检核验工程的交付"@zh ;
    yd:archRef "第一节" ;
    yd:quote "质检交付 → 缺陷或放行。它是默认形态里的核验角色……工程被质检评价，所以工程不改质检的材料。" ;
    yd:verifier yd:dept-qa ;
    yd:verified yd:dept-engineering ;
    yd:forOutcome yd:ok-delivery ;
    yd:inForm yd:form-default .
# UNSURE: 「结论靠质检这个核验角色的独立证据」没说是三种独立证据里的哪几种，所以没写 yd:hasIndependentEvidence。

# ---------- 独立的证据（三种来源） ----------
yd:ie-host-check-receipt a yd:IndependentEvidence ;
    rdfs:label "主机跑的检查回执"@zh ;
    yd:archRef "第一节" ;
    yd:quote "独立的证据主机跑的检查回执、另一个模型的判断、你的回答。" .

yd:ie-other-model-judgment a yd:IndependentEvidence ;
    rdfs:label "另一个模型的判断"@zh ;
    yd:archRef "第一节" ;
    yd:quote "独立的证据主机跑的检查回执、另一个模型的判断、你的回答。" .

yd:ie-your-answer a yd:IndependentEvidence ;
    rdfs:label "你的回答"@zh ;
    yd:archRef "第一节" ;
    yd:quote "独立的证据主机跑的检查回执、另一个模型的判断、你的回答。" .

# ---------- 事项的来源 ----------
yd:src-user-input a yd:Source ;
    rdfs:label "你的输入"@zh ;
    yd:archRef "第二节" ;
    yd:quote "事项的来源（你的输入、建档；子事项是上一层交来的任务；以后加运维发现的故障）与接它的职能" .

yd:src-filing a yd:Source ;
    rdfs:label "建档"@zh ;
    yd:archRef "第二节" ;
    yd:quote "事项的来源（你的输入、建档；子事项是上一层交来的任务；以后加运维发现的故障）与接它的职能" .

yd:src-parent-task a yd:Source ;
    rdfs:label "上一层交来的任务"@zh ;
    yd:archRef "第二节" ;
    yd:quote "事项的来源（你的输入、建档；子事项是上一层交来的任务；以后加运维发现的故障）与接它的职能" .

yd:src-ops-fault a yd:Source ;
    rdfs:label "运维发现的故障"@zh ;
    yd:archRef "第二节" ;
    yd:quote "事项的来源（你的输入、建档；子事项是上一层交来的任务；以后加运维发现的故障）与接它的职能" ;
    yd:planned true .
# UNSURE: 总图只说来源「与接它的职能」住在定义里，没说哪个职能接哪种来源，所以没写 yd:receives。

# ---------- 第一节方框里的部件 ----------
yd:comp-page a yd:Component ;
    rdfs:label "页面"@zh ;
    yd:archRef "第一节" ;
    yd:quote "页面你看到的列表与详情，只读事实；回答决定、看状态、分清开环完成与放行、点开原始事件都在这里，命令从这里发。" .

yd:comp-one-fact a yd:Component ;
    rdfs:label "一份事实"@zh ;
    yd:archRef "第一节" ;
    yd:quote "一份事实发生过的事只记一份，只追加，谁都不能改。" .

yd:comp-thin-driver a yd:Component ;
    rdfs:label "薄驱动"@zh ;
    yd:archRef "第一节" ;
    yd:quote "薄驱动只做连接：读事实、问路由、问装配、交执行、经写入口写回。不认识职能的名字。" ;
    yd:inRing yd:ring-approve-only .

yd:comp-slot-routing a yd:Component ;
    rdfs:label "槽位：路由"@zh ;
    yd:archRef "第一节" ;
    yd:quote "槽位：路由谁开工、一轮怎么结束、事项怎么结束。" .

yd:comp-slot-assembly a yd:Component ;
    rdfs:label "槽位：装配"@zh ;
    yd:archRef "第一节" ;
    yd:quote "槽位：装配从事实减出这一轮要看的，交给模型的那份记进事实。" .

yd:comp-slot-execution a yd:Component ;
    rdfs:label "槽位：执行"@zh ;
    yd:archRef "第一节" ;
    yd:quote "槽位：执行一轮里的每一步：问边界、调模型、发工具请求。" .

yd:comp-model-and-tools a yd:Component ;
    rdfs:label "模型与工具"@zh ;
    yd:archRef "第一节" ;
    yd:quote "模型与工具调模型、改文件、跑命令、查网络；本机或远程。每个动作带前后快照的差异与回执。" .

yd:comp-evaluation a yd:Component ;
    rdfs:label "评价"@zh ;
    yd:archRef "第一节" ;
    yd:quote "评价评测题与判分器、发布检查。在系统之外，被开发的版本读不到。" .

yd:comp-watchdog a yd:Component ;
    rdfs:label "看门狗"@zh ;
    yd:archRef "第一节" ;
    yd:quote "看门狗在进程外面。两个槽位，候选版本失败就切回稳定版。" ;
    yd:inRing yd:ring-approve-only .

yd:comp-observer a yd:Component ;
    rdfs:label "观察者"@zh ;
    yd:archRef "第一节" ;
    yd:quote "观察者在系统外面看。只出证据、提案与振荡信号，都经写入口；不动手。" ;
    yd:inRing yd:ring-rewritable .

yd:comp-view a yd:Component ;
    rdfs:label "画面"@zh ;
    yd:archRef "第一节" ;
    yd:quote "画面在系统外面，像观察者一样只经接口读事实，操作也只发现有的命令。" ;
    yd:inRing yd:ring-rewritable .

# ======================= 第二节：三环与四层 =======================

yd:ring-rewritable a yd:Ring ;
    rdfs:label "可以整体重写"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。重写以后外面看不出区别。" .

yd:ring-backward-compatible a yd:Ring ;
    rdfs:label "只能向后兼容"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只能向后兼容三道槽位契约（路由、装配、执行）、骨架事件、对外的合同、定义的格式。字段只增，带版本。" .

yd:ring-approve-only a yd:Ring ;
    rdfs:label "只由你批准"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只由你批准一份事实的写入口、裁决、边界、薄驱动与插件加载、评价材料、看门狗。" .

# ---------- 环里的部件 ----------
yd:comp-routing-impl a yd:Component ;
    rdfs:label "路由实现"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" ;
    yd:inRing yd:ring-rewritable .

yd:comp-assembly-impl a yd:Component ;
    rdfs:label "装配实现"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" ;
    yd:inRing yd:ring-rewritable .

yd:comp-execution-impl a yd:Component ;
    rdfs:label "执行实现"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" ;
    yd:inRing yd:ring-rewritable .

yd:comp-model-env-adapter a yd:Component ;
    rdfs:label "模型与执行环境的适配"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" ;
    yd:inRing yd:ring-rewritable .

yd:comp-projection a yd:Component ;
    rdfs:label "投影"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" ;
    yd:inRing yd:ring-rewritable .

yd:comp-slot-contracts a yd:Component ;
    rdfs:label "三道槽位契约（路由、装配、执行）"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只能向后兼容三道槽位契约（路由、装配、执行）、骨架事件、对外的合同、定义的格式。" ;
    yd:inRing yd:ring-backward-compatible .

yd:comp-skeleton-events a yd:Component ;
    rdfs:label "骨架事件"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只能向后兼容三道槽位契约（路由、装配、执行）、骨架事件、对外的合同、定义的格式。" ;
    yd:inRing yd:ring-backward-compatible .

yd:comp-external-contracts a yd:Component ;
    rdfs:label "对外的合同"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只能向后兼容三道槽位契约（路由、装配、执行）、骨架事件、对外的合同、定义的格式。" ;
    yd:inRing yd:ring-backward-compatible .

yd:comp-definition-format a yd:Component ;
    rdfs:label "定义的格式"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只能向后兼容三道槽位契约（路由、装配、执行）、骨架事件、对外的合同、定义的格式。" ;
    yd:inRing yd:ring-backward-compatible .

yd:comp-write-gate a yd:Component ;
    rdfs:label "写入口"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只由你批准一份事实的写入口、裁决、边界、薄驱动与插件加载、评价材料、看门狗。" ;
    yd:inRing yd:ring-approve-only .

yd:comp-plugin-loading a yd:Component ;
    rdfs:label "插件加载"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只由你批准一份事实的写入口、裁决、边界、薄驱动与插件加载、评价材料、看门狗。" ;
    yd:inRing yd:ring-approve-only .

yd:comp-eval-materials a yd:Component ;
    rdfs:label "评价材料"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只由你批准一份事实的写入口、裁决、边界、薄驱动与插件加载、评价材料、看门狗。" ;
    yd:inRing yd:ring-approve-only .
# NOTE: 第二节里的「定义带版本的数据……」一段不是三环之一，没给它 inRing。

# ---------- 四层 ----------
yd:layer-facts-adjudication a yd:Layer ;
    rdfs:label "事实与裁决"@zh ;
    yd:archRef "第二节「四层」" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求" ;
    yd:above yd:layer-loop ;
    yd:recognizes yd:c-item , yd:c-event , yd:c-outcome-version , yd:c-proposal , yd:c-receipt ,
        yd:c-write-scope , yd:c-limit , yd:c-decision-request .

yd:layer-loop a yd:Layer ;
    rdfs:label "循环"@zh ;
    yd:archRef "第二节「四层」" ;
    yd:quote "循环只认一轮工作，谁开工、怎么结束都问路由" ;
    yd:above yd:layer-routing ;
    yd:recognizes yd:c-round .

yd:layer-routing a yd:Layer ;
    rdfs:label "路由"@zh ;
    yd:archRef "第二节「四层」" ;
    yd:quote "路由各自写轮转的规矩，核验从核验角色取" ;
    yd:above yd:layer-organization .

yd:layer-organization a yd:Layer ;
    rdfs:label "组织（定义）"@zh ;
    yd:archRef "第二节「四层」" ;
    yd:quote "组织（定义）往里填职能与角色。" .
# NOTE: yd:above 写成「主语在宾语上面」：事实与裁决 > 循环 > 路由 > 组织，依据「都只换下面两层，任何一种要改上面两层」。
# UNSURE: 路由层和组织层的原句没用「只认」，没写它们的 yd:recognizes。

# ---------- 层认识的词 ----------
yd:c-item a yd:Concept ; rdfs:label "事项"@zh ; yd:archRef "第二节「四层」" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求" .
yd:c-event a yd:Concept ; rdfs:label "事件"@zh ; yd:archRef "第二节「四层」" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求" .
yd:c-outcome-version a yd:Concept ; rdfs:label "某种成果的某一版及其依据"@zh ; yd:archRef "第二节「四层」" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求" .
yd:c-proposal a yd:Concept ; rdfs:label "提案"@zh ; yd:archRef "第二节「四层」" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求" .
yd:c-receipt a yd:Concept ; rdfs:label "回执"@zh ; yd:archRef "第二节「四层」" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求" .
yd:c-write-scope a yd:Concept ; rdfs:label "角色的写入范围"@zh ; yd:archRef "第二节「四层」" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求" .
yd:c-limit a yd:Concept ; rdfs:label "上限"@zh ; yd:archRef "第二节「四层」" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求" .
yd:c-decision-request a yd:Concept ; rdfs:label "决定请求"@zh ; yd:archRef "第二节「四层」" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求" .
yd:c-round a yd:Concept ; rdfs:label "一轮工作"@zh ; yd:archRef "第二节「四层」" ;
    yd:quote "循环只认一轮工作，谁开工、怎么结束都问路由" .

# ======================= 第三节：外环、内环、上限 =======================

yd:loop-outer a yd:LoopLayer ;
    rdfs:label "外环"@zh ;
    yd:archRef "第三节外环" ;
    yd:quote "外环 · 职能之间的流转（直做、按成果、任务池共用这套状态）" ;
    yd:hasState yd:os-asking , yd:os-waiting-user , yd:os-waiting-work , yd:os-in-round ,
        yd:os-verifying , yd:os-accepting , yd:os-draining , yd:os-rework , yd:os-stopped ;
    yd:stopsBy yd:srl-closed .

yd:loop-inner a yd:LoopLayer ;
    rdfs:label "内环"@zh ;
    yd:archRef "第三节" ;
    yd:quote "内环 · 一轮工作里的每一步（薄驱动连接，每步都停得下来）" ;
    yd:hasLimit yd:lim-time , yd:lim-count , yd:lim-retry , yd:lim-nesting-depth ;
    yd:stopsBy yd:srl-closed .
# NOTE: 内环的六步（路由与边界、装配、模型 / 外包、工具与环境、裁决与写入口、投影）没有对应的类，没抽。
# UNSURE: 「每一步先问边界：时间、次数、重试、嵌套深度来自定义」挂在内环上，是按「每一步」读的；外环是否也有这些上限，原文没说。
# UNSURE: 「事项完成」在外环图里像一个终点，但原文没给它描述，只出现在「放行或开环完成事项完成」里，没当外环的状态抽。

yd:os-asking a yd:OuterState ; rdfs:label "询问中"@zh ; yd:archRef "第三节外环" ;
    yd:quote "询问中嵌在一轮里的另一轮，等回应" .
yd:os-waiting-user a yd:OuterState ; rdfs:label "等用户"@zh ; yd:archRef "第三节外环" ;
    yd:quote "等用户决定请求停在写入口" .
yd:os-waiting-work a yd:OuterState ; rdfs:label "等待工作"@zh ; yd:archRef "第三节外环" ;
    yd:quote "等待工作关注的成果更新 / 待认领" .
yd:os-in-round a yd:OuterState ; rdfs:label "一轮工作中"@zh ; yd:archRef "第三节外环" ;
    yd:quote "一轮工作中派发编号 + 从快照建工作区" .
yd:os-verifying a yd:OuterState ; rdfs:label "核验中"@zh ; yd:archRef "第三节外环" ;
    yd:quote "核验中独立副本检查 + 回执" .
yd:os-accepting a yd:OuterState ; rdfs:label "接纳"@zh ; yd:archRef "第三节外环" ;
    yd:quote "接纳绑定合同、交付树、回执" .
yd:os-draining a yd:OuterState ; rdfs:label "排空中"@zh ; yd:archRef "第三节外环" ;
    yd:quote "排空中不接新事项，等在途的结束" .
yd:os-rework a yd:OuterState ; rdfs:label "返工"@zh ; yd:archRef "第三节外环" ;
    yd:quote "返工打回给被核验的一方" .
yd:os-stopped a yd:OuterState ; rdfs:label "停止"@zh ; yd:archRef "第三节外环" ;
    yd:quote "停止原因来自封闭清单" .

yd:srl-closed a yd:StopReasonList ;
    rdfs:label "停止原因清单"@zh ;
    yd:archRef "第三节外环" ;
    yd:quote "停止原因来自封闭清单……到了就停，原因写进封闭清单里的一条。" .

yd:lim-time a yd:Limit ; rdfs:label "时间"@zh ; yd:archRef "第三节" ;
    yd:quote "每一步先问边界：时间、次数、重试、嵌套深度来自定义；到了就停，原因写进封闭清单里的一条。" .
yd:lim-count a yd:Limit ; rdfs:label "次数"@zh ; yd:archRef "第三节" ;
    yd:quote "每一步先问边界：时间、次数、重试、嵌套深度来自定义；到了就停，原因写进封闭清单里的一条。" .
yd:lim-retry a yd:Limit ; rdfs:label "重试"@zh ; yd:archRef "第三节" ;
    yd:quote "每一步先问边界：时间、次数、重试、嵌套深度来自定义；到了就停，原因写进封闭清单里的一条。" .
yd:lim-nesting-depth a yd:Limit ; rdfs:label "嵌套深度"@zh ; yd:archRef "第三节" ;
    yd:quote "每一步先问边界：时间、次数、重试、嵌套深度来自定义；到了就停，原因写进封闭清单里的一条。" .
yd:lim-suborg-layers a yd:Limit ; rdfs:label "层数"@zh ; yd:archRef "第三节" ;
    yd:quote "时间与用量从上一层剩下的里扣，层数有上限" .

# ======================= 第四节：缝 =======================

yd:ss-settled a yd:SeamStatus ; rdfs:label "已定"@zh ; yd:archRef "第四节" ;
    yd:quote "已定：规矩不再改，子架构师现在就守" .
yd:ss-unsettled a yd:SeamStatus ; rdfs:label "未定"@zh ; yd:archRef "第四节" ;
    yd:quote "未定：我还在定，先别依赖。" .

# ---------- 系统里的九道 ----------
yd:seam-write-gate a yd:Seam ; rdfs:label "写入口"@zh ; yd:archRef "第四节" ;
    yd:quote "写入口已定一切写入方 ↔ 一份事实事实只从这里进，进了就不改。" ;
    yd:status yd:ss-settled ; yd:inSystem true ;
    yd:side yd:comp-all-writers , yd:comp-one-fact .

yd:seam-routing a yd:Seam ; rdfs:label "路由"@zh ; yd:archRef "第四节" ;
    yd:quote "路由已定薄驱动 ↔ 路由实现换轮转方式，循环本身不动。" ;
    yd:status yd:ss-settled ; yd:inSystem true ;
    yd:side yd:comp-thin-driver , yd:comp-routing-impl .

yd:seam-assembly a yd:Seam ; rdfs:label "装配"@zh ; yd:archRef "第四节" ;
    yd:quote "装配已定执行 ↔ 装配实现一轮看到的是事实的一个视图，不改事实。" ;
    yd:status yd:ss-settled ; yd:inSystem true ;
    yd:side yd:comp-execution , yd:comp-assembly-impl .

yd:seam-execution a yd:Seam ; rdfs:label "执行"@zh ; yd:archRef "第四节" ;
    yd:quote "执行已定薄驱动 ↔ 执行实现一轮里的每一步都停得下来。" ;
    yd:status yd:ss-settled ; yd:inSystem true ;
    yd:side yd:comp-thin-driver , yd:comp-execution-impl .

yd:seam-model a yd:Seam ; rdfs:label "模型"@zh ; yd:archRef "第四节" ;
    yd:quote "模型已定执行 ↔ 模型服务换模型不改循环。" ;
    yd:status yd:ss-settled ; yd:inSystem true ;
    yd:side yd:comp-execution , yd:comp-model-service .

yd:seam-action a yd:Seam ; rdfs:label "动作"@zh ; yd:archRef "第四节" ;
    yd:quote "动作已定工具 ↔ 执行环境每个动作有回执；结果未知时有核实办法。" ;
    yd:status yd:ss-settled ; yd:inSystem true ;
    yd:side yd:comp-tools , yd:comp-exec-environment .

yd:seam-projection a yd:Seam ; rdfs:label "投影"@zh ; yd:archRef "第四节" ;
    yd:quote "投影已定一份事实 → 读的人任何投影都能从事实重算。" ;
    yd:status yd:ss-settled ; yd:inSystem true ;
    yd:side yd:comp-one-fact , yd:comp-readers .

yd:seam-interface a yd:Seam ; rdfs:label "接口"@zh ; yd:archRef "第四节" ;
    yd:quote "接口已定页面、命令行、评测、观察者、画面 ↔ 应用层外面只经这里读与发。" ;
    yd:status yd:ss-settled ; yd:inSystem true ;
    yd:side yd:comp-page , yd:comp-cli , yd:comp-eval-runs , yd:comp-observer , yd:comp-view , yd:comp-app-layer .

yd:seam-definition a yd:Seam ; rdfs:label "定义"@zh ; yd:archRef "第四节" ;
    yd:quote "定义已定定义文件 ↔ 加载与校验改定义不改代码，能撤回。" ;
    yd:status yd:ss-settled ; yd:inSystem true ;
    yd:side yd:comp-definition-files , yd:comp-load-validate .

# ---------- 系统之外的四道 ----------
yd:seam-evaluation a yd:Seam ; rdfs:label "评价"@zh ; yd:archRef "第四节" ;
    yd:quote "评价已定评价材料 → 系统被开发的版本读不到评它的题。" ;
    yd:status yd:ss-settled ; yd:inSystem false ;
    yd:side yd:comp-eval-materials , yd:comp-dev-version .

yd:seam-observer a yd:Seam ; rdfs:label "观察者"@zh ; yd:archRef "第四节" ;
    yd:quote "观察者已定观察者 ↔ 接口（读）与写入口（写）只看，不动手。" ;
    yd:status yd:ss-settled ; yd:inSystem false ;
    yd:side yd:comp-observer , yd:comp-interface , yd:comp-write-gate .

yd:seam-view a yd:Seam ; rdfs:label "画面"@zh ; yd:archRef "第四节" ;
    yd:quote "画面已定接口 ↔ 画面画面整个换掉或落后，事实与页面不动。" ;
    yd:status yd:ss-settled ; yd:inSystem false ;
    yd:side yd:comp-interface , yd:comp-view .

yd:seam-watchdog a yd:Seam ; rdfs:label "看门狗"@zh ; yd:archRef "第四节" ;
    yd:quote "看门狗未定看门狗 ↔ 实例候选失败能退回。" ;
    yd:status yd:ss-unsettled ; yd:inSystem false ;
    yd:side yd:comp-watchdog , yd:comp-instance .
# NOTE: 每道缝的「保证什么、规矩、交换什么」在词汇里没有属性，没抽。

# ---------- 只出现在缝两侧的部件 ----------
yd:comp-all-writers a yd:Component ; rdfs:label "一切写入方"@zh ; yd:archRef "第四节" ;
    yd:quote "写入口已定一切写入方 ↔ 一份事实" .
yd:comp-execution a yd:Component ; rdfs:label "执行"@zh ; yd:archRef "第四节" ;
    yd:quote "装配已定执行 ↔ 装配实现……模型已定执行 ↔ 模型服务" .
# UNSURE: 装配缝与模型缝一侧的「执行」可能就是「槽位：执行」或「执行实现」，原文没说，单独立了一个部件。
yd:comp-model-service a yd:Component ; rdfs:label "模型服务"@zh ; yd:archRef "第四节" ;
    yd:quote "模型已定执行 ↔ 模型服务换模型不改循环。" .
yd:comp-tools a yd:Component ; rdfs:label "工具"@zh ; yd:archRef "第四节" ;
    yd:quote "动作已定工具 ↔ 执行环境" .
yd:comp-exec-environment a yd:Component ; rdfs:label "执行环境"@zh ; yd:archRef "第四节" ;
    yd:quote "动作已定工具 ↔ 执行环境" .
yd:comp-readers a yd:Component ; rdfs:label "读的人"@zh ; yd:archRef "第四节" ;
    yd:quote "投影已定一份事实 → 读的人" .
yd:comp-cli a yd:Component ; rdfs:label "命令行"@zh ; yd:archRef "第四节" ;
    yd:quote "接口已定页面、命令行、评测、观察者、画面 ↔ 应用层" .
yd:comp-eval-runs a yd:Component ; rdfs:label "评测"@zh ; yd:archRef "第四节" ;
    yd:quote "接口已定页面、命令行、评测、观察者、画面 ↔ 应用层" .
yd:comp-app-layer a yd:Component ; rdfs:label "应用层"@zh ; yd:archRef "第四节" ;
    yd:quote "接口已定页面、命令行、评测、观察者、画面 ↔ 应用层" .
yd:comp-definition-files a yd:Component ; rdfs:label "定义文件"@zh ; yd:archRef "第四节" ;
    yd:quote "定义已定定义文件 ↔ 加载与校验" .
yd:comp-load-validate a yd:Component ; rdfs:label "加载与校验"@zh ; yd:archRef "第四节" ;
    yd:quote "定义已定定义文件 ↔ 加载与校验" .
yd:comp-dev-version a yd:Component ; rdfs:label "系统被开发的版本"@zh ; yd:archRef "第四节" ;
    yd:quote "评价已定评价材料 → 系统被开发的版本读不到评它的题。" .
yd:comp-interface a yd:Component ; rdfs:label "接口"@zh ; yd:archRef "第四节" ;
    yd:quote "观察者已定观察者 ↔ 接口（读）与写入口（写）……画面已定接口 ↔ 画面" .
yd:comp-instance a yd:Component ; rdfs:label "实例"@zh ; yd:archRef "第四节" ;
    yd:quote "看门狗未定看门狗 ↔ 实例候选失败能退回。" .

# NOTE: 第五节（两层自举、三层验收）和第六节（控制主机、机器 B/C、只有一份 / 可以多份 / 只读）在词汇里没有对应的类，没抽。
