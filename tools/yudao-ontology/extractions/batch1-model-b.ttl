@prefix yd:   <https://yudao.dev/onto#> .
@prefix b:    <https://yudao.dev/onto-b#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

b:fs-loop a yd:FixedStructure ;
    rdfs:label "循环"@zh ;
    yd:archRef "开头一段" ;
    yd:quote "固定不变的只有三样：循环、边界、裁决" .

b:fs-boundary a yd:FixedStructure ;
    rdfs:label "边界"@zh ;
    yd:archRef "开头一段" ;
    yd:quote "固定不变的只有三样：循环、边界、裁决" .

b:fs-verdict a yd:FixedStructure ;
    rdfs:label "裁决"@zh ;
    yd:archRef "开头一段" ;
    yd:quote "固定不变的只有三样：循环、边界、裁决" .

b:cn-item a yd:Concept ;
    rdfs:label "事项"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" .

b:cn-event a yd:Concept ;
    rdfs:label "事件"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" .

b:cn-outcome-version a yd:Concept ;
    rdfs:label "某种成果的某一版及其依据"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" .

b:cn-proposal a yd:Concept ;
    rdfs:label "提案"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" .

b:cn-receipt a yd:Concept ;
    rdfs:label "回执"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" .

b:cn-write-scope a yd:Concept ;
    rdfs:label "角色的写入范围"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" .

b:cn-limit-concept a yd:Concept ;
    rdfs:label "上限"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" .

b:cn-decision-request a yd:Concept ;
    rdfs:label "决定请求"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" .

b:cn-round a yd:Concept ;
    rdfs:label "一轮工作"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" .

b:ly-fact a yd:Layer ;
    rdfs:label "事实与裁决"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" ;
    yd:recognizes b:cn-item, b:cn-event, b:cn-outcome-version, b:cn-proposal, b:cn-receipt, b:cn-write-scope, b:cn-limit-concept, b:cn-decision-request ;
    yd:above b:ly-loop .

b:ly-loop a yd:Layer ;
    rdfs:label "循环"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" ;
    yd:recognizes b:cn-round ;
    yd:above b:ly-route .

b:ly-route a yd:Layer ;
    rdfs:label "路由"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" ;
    yd:above b:ly-org .

b:ly-org a yd:Layer ;
    rdfs:label "组织（定义）"@zh ;
    yd:archRef "第二节" ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填职能与角色。" .

# UNSURE: the text gives the three rings no names (paragraph headings missing); labels below paraphrase each ring's own first words


b:ring-1 a yd:Ring ;
    rdfs:label "可以整体重写的一环"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" .

b:ring-2 a yd:Ring ;
    rdfs:label "只能向后兼容的一环"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只能向后兼容三道槽位契约（路由、装配、执行）、骨架事件、对外的合同、定义的格式。" .

b:ring-3 a yd:Ring ;
    rdfs:label "只由你批准的一环"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只由你批准一份事实的写入口、裁决、边界、薄驱动与插件加载、评价材料、看门狗。" .

# NOTE: the fourth paragraph of section 2 (定义：带版本的数据) is not counted among the three rings; no ring asserted for it


b:c-route-impl a yd:Component ;
    rdfs:label "路由实现"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" ;
    yd:inRing b:ring-1 .

b:c-assemble-impl a yd:Component ;
    rdfs:label "装配实现"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" ;
    yd:inRing b:ring-1 .

b:c-exec-impl a yd:Component ;
    rdfs:label "执行实现"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" ;
    yd:inRing b:ring-1 .

b:c-model-adapter a yd:Component ;
    rdfs:label "模型与执行环境的适配"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" ;
    yd:inRing b:ring-1 .

b:c-projection a yd:Component ;
    rdfs:label "投影"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" ;
    yd:inRing b:ring-1 .

b:c-screen a yd:Component ;
    rdfs:label "画面"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" ;
    yd:inRing b:ring-1 .

b:c-observer a yd:Component ;
    rdfs:label "观察者"@zh ;
    yd:archRef "第二节" ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。" ;
    yd:inRing b:ring-1 .

b:c-slot-contracts a yd:Component ;
    rdfs:label "三道槽位契约（路由、装配、执行）"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只能向后兼容三道槽位契约（路由、装配、执行）、骨架事件、对外的合同、定义的格式。" ;
    yd:inRing b:ring-2 .

b:c-skeleton-events a yd:Component ;
    rdfs:label "骨架事件"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只能向后兼容三道槽位契约（路由、装配、执行）、骨架事件、对外的合同、定义的格式。" ;
    yd:inRing b:ring-2 .

b:c-external-contracts a yd:Component ;
    rdfs:label "对外的合同"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只能向后兼容三道槽位契约（路由、装配、执行）、骨架事件、对外的合同、定义的格式。" ;
    yd:inRing b:ring-2 .

b:c-def-format a yd:Component ;
    rdfs:label "定义的格式"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只能向后兼容三道槽位契约（路由、装配、执行）、骨架事件、对外的合同、定义的格式。" ;
    yd:inRing b:ring-2 .

b:c-write-gate a yd:Component ;
    rdfs:label "一份事实的写入口"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只由你批准一份事实的写入口、裁决、边界、薄驱动与插件加载、评价材料、看门狗。" ;
    yd:inRing b:ring-3 .

b:c-ruling a yd:Component ;
    rdfs:label "裁决"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只由你批准一份事实的写入口、裁决、边界、薄驱动与插件加载、评价材料、看门狗。" ;
    yd:inRing b:ring-3 .

b:c-boundary a yd:Component ;
    rdfs:label "边界"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只由你批准一份事实的写入口、裁决、边界、薄驱动与插件加载、评价材料、看门狗。" ;
    yd:inRing b:ring-3 .

b:c-driver-plugin a yd:Component ;
    rdfs:label "薄驱动与插件加载"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只由你批准一份事实的写入口、裁决、边界、薄驱动与插件加载、评价材料、看门狗。" ;
    yd:inRing b:ring-3 .

b:c-eval-material a yd:Component ;
    rdfs:label "评价材料"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只由你批准一份事实的写入口、裁决、边界、薄驱动与插件加载、评价材料、看门狗。" ;
    yd:inRing b:ring-3 .

b:c-watchdog a yd:Component ;
    rdfs:label "看门狗"@zh ;
    yd:archRef "第二节" ;
    yd:quote "只由你批准一份事实的写入口、裁决、边界、薄驱动与插件加载、评价材料、看门狗。" ;
    yd:inRing b:ring-3 .

# NOTE: seam names reuse the component names; seam individuals are b:seam-*, components b:c-*


# UNSURE: seam 接口's one side lists five clients (页面、命令行、评测、观察者、画面); modeled as one composite component, not split


# NOTE: 薄驱动 / 执行 / 路由实现 etc. reuse of ring components: c-route-impl, c-exec-impl, c-assemble-impl, c-projection... seam sides reuse the ring-1/3 IRIs where the label is identical (route-impl, assemble-impl, exec-impl, observer, screen, watchdog, write-gate)


b:c-all-writers a yd:Component ;
    rdfs:label "一切写入方"@zh ;
    yd:archRef "第四节" ;
    yd:quote "写入口已定一切写入方 ↔ 一份事实" .

b:c-fact a yd:Component ;
    rdfs:label "一份事实"@zh ;
    yd:archRef "第四节" ;
    yd:quote "写入口已定一切写入方 ↔ 一份事实" .

b:c-driver a yd:Component ;
    rdfs:label "薄驱动"@zh ;
    yd:archRef "第四节" ;
    yd:quote "路由已定薄驱动 ↔ 路由实现" .

b:c-exec a yd:Component ;
    rdfs:label "执行"@zh ;
    yd:archRef "第四节" ;
    yd:quote "装配已定执行 ↔ 装配实现" .

b:c-model-service a yd:Component ;
    rdfs:label "模型服务"@zh ;
    yd:archRef "第四节" ;
    yd:quote "模型已定执行 ↔ 模型服务" .

b:c-tools a yd:Component ;
    rdfs:label "工具"@zh ;
    yd:archRef "第四节" ;
    yd:quote "动作已定工具 ↔ 执行环境" .

b:c-exec-env a yd:Component ;
    rdfs:label "执行环境"@zh ;
    yd:archRef "第四节" ;
    yd:quote "动作已定工具 ↔ 执行环境" .

b:c-readers a yd:Component ;
    rdfs:label "读的人"@zh ;
    yd:archRef "第四节" ;
    yd:quote "投影已定一份事实 → 读的人" .

b:c-interface-clients a yd:Component ;
    rdfs:label "页面、命令行、评测、观察者、画面"@zh ;
    yd:archRef "第四节" ;
    yd:quote "接口已定页面、命令行、评测、观察者、画面 ↔ 应用层" .

b:c-app-layer a yd:Component ;
    rdfs:label "应用层"@zh ;
    yd:archRef "第四节" ;
    yd:quote "接口已定页面、命令行、评测、观察者、画面 ↔ 应用层" .

b:c-def-files a yd:Component ;
    rdfs:label "定义文件"@zh ;
    yd:archRef "第四节" ;
    yd:quote "定义已定定义文件 ↔ 加载与校验" .

b:c-loader a yd:Component ;
    rdfs:label "加载与校验"@zh ;
    yd:archRef "第四节" ;
    yd:quote "定义已定定义文件 ↔ 加载与校验" .

b:c-dev-version a yd:Component ;
    rdfs:label "系统被开发的版本"@zh ;
    yd:archRef "第四节" ;
    yd:quote "评价已定评价材料 → 系统被开发的版本" .

b:c-interface a yd:Component ;
    rdfs:label "接口"@zh ;
    yd:archRef "第四节" ;
    yd:quote "观察者已定观察者 ↔ 接口（读）与写入口（写）" .

b:c-instance a yd:Component ;
    rdfs:label "实例"@zh ;
    yd:archRef "第四节" ;
    yd:quote "看门狗未定看门狗 ↔ 实例" .

b:seam-write-gate a yd:Seam ;
    rdfs:label "写入口"@zh ;
    yd:archRef "第四节" ;
    yd:quote "写入口已定一切写入方 ↔ 一份事实" ;
    yd:side b:c-all-writers, b:c-fact ;
    yd:status b:ss-decided ;
    yd:inSystem true .

b:seam-route a yd:Seam ;
    rdfs:label "路由"@zh ;
    yd:archRef "第四节" ;
    yd:quote "路由已定薄驱动 ↔ 路由实现" ;
    yd:side b:c-driver, b:c-route-impl ;
    yd:status b:ss-decided ;
    yd:inSystem true .

b:seam-assemble a yd:Seam ;
    rdfs:label "装配"@zh ;
    yd:archRef "第四节" ;
    yd:quote "装配已定执行 ↔ 装配实现" ;
    yd:side b:c-exec, b:c-assemble-impl ;
    yd:status b:ss-decided ;
    yd:inSystem true .

b:seam-exec a yd:Seam ;
    rdfs:label "执行"@zh ;
    yd:archRef "第四节" ;
    yd:quote "执行已定薄驱动 ↔ 执行实现" ;
    yd:side b:c-driver, b:c-exec-impl ;
    yd:status b:ss-decided ;
    yd:inSystem true .

b:seam-model a yd:Seam ;
    rdfs:label "模型"@zh ;
    yd:archRef "第四节" ;
    yd:quote "模型已定执行 ↔ 模型服务" ;
    yd:side b:c-exec, b:c-model-service ;
    yd:status b:ss-decided ;
    yd:inSystem true .

b:seam-action a yd:Seam ;
    rdfs:label "动作"@zh ;
    yd:archRef "第四节" ;
    yd:quote "动作已定工具 ↔ 执行环境" ;
    yd:side b:c-tools, b:c-exec-env ;
    yd:status b:ss-decided ;
    yd:inSystem true .

b:seam-projection a yd:Seam ;
    rdfs:label "投影"@zh ;
    yd:archRef "第四节" ;
    yd:quote "投影已定一份事实 → 读的人" ;
    yd:side b:c-fact, b:c-readers ;
    yd:status b:ss-decided ;
    yd:inSystem true .

b:seam-interface a yd:Seam ;
    rdfs:label "接口"@zh ;
    yd:archRef "第四节" ;
    yd:quote "接口已定页面、命令行、评测、观察者、画面 ↔ 应用层" ;
    yd:side b:c-interface-clients, b:c-app-layer ;
    yd:status b:ss-decided ;
    yd:inSystem true .

b:seam-definition a yd:Seam ;
    rdfs:label "定义"@zh ;
    yd:archRef "第四节" ;
    yd:quote "定义已定定义文件 ↔ 加载与校验" ;
    yd:side b:c-def-files, b:c-loader ;
    yd:status b:ss-decided ;
    yd:inSystem true .

b:seam-eval a yd:Seam ;
    rdfs:label "评价"@zh ;
    yd:archRef "第四节" ;
    yd:quote "评价已定评价材料 → 系统被开发的版本" ;
    yd:side b:c-eval-material, b:c-dev-version ;
    yd:status b:ss-decided ;
    yd:inSystem false .

b:seam-observer a yd:Seam ;
