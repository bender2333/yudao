b:ss-undecided a yd:SeamStatus ;
    rdfs:label "未定"@zh ;
    yd:archRef "第四节" ;
    yd:quote "未定：我还在定，先别依赖" .

# NOTE: the text names 13 seams (9 in system, 4 outside) and the 第五节 table says 十三道合同; all 13 listed above


b:os-asking a yd:OuterState ;
    rdfs:label "询问中"@zh ;
