b:lim-time a yd:Limit ;
    rdfs:label "时间"@zh ;
    yd:archRef "第三节" ;
    yd:quote "每一步先问边界：时间、次数、重试、嵌套深度来自定义；到了就停，原因写进封闭清单里的一条。" .

b:lim-count a yd:Limit ;
    rdfs:label "次数"@zh ;
    yd:archRef "第三节" ;
    yd:quote "每一步先问边界：时间、次数、重试、嵌套深度来自定义；到了就停，原因写进封闭清单里的一条。" .

b:lim-retry a yd:Limit ;
    rdfs:label "重试"@zh ;
    yd:archRef "第三节" ;
    yd:quote "每一步先问边界：时间、次数、重试、嵌套深度来自定义；到了就停，原因写进封闭清单里的一条。" .

b:lim-depth a yd:Limit ;
    rdfs:label "嵌套深度"@zh ;
    yd:archRef "第三节" ;
    yd:quote "每一步先问边界：时间、次数、重试、嵌套深度来自定义；到了就停，原因写进封闭清单里的一条。" .

b:srl-closed a yd:StopReasonList ;
    rdfs:label "封闭清单"@zh ;
    yd:archRef "第三节" ;
    yd:quote "停止原因来自封闭清单" .

b:ll-outer a yd:LoopLayer ;
    rdfs:label "外环 · 职能之间的流转"@zh ;
    yd:archRef "第三节" ;
    yd:quote "外环 · 职能之间的流转（直做、按成果、任务池共用这套状态）" ;
    yd:hasState b:os-asking, b:os-wait-user, b:os-waiting, b:os-in-round, b:os-verifying, b:os-accepted, b:os-draining, b:os-rework, b:os-stopped ;
    yd:hasLimit b:lim-time, b:lim-count, b:lim-retry, b:lim-depth ;
    yd:stopsBy b:srl-closed .

