# 第 2 批（抽取 A）：工程的中心型小组（设计说明 4.1–4.4）。
# yd:dept-engineering 与 yd:rm-direct 已经有了，这里只引用；其余 IRI 都以 eg- 开头，是这一批自己起的。
@prefix yd:   <https://yudao.dev/onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ======================= 形态与轮转 =======================

yd:eg-form-center-group a yd:Form ;
    rdfs:label "中心型小组"@zh ;
    yd:archRef "4.2" ;
    yd:quote "职能的角色定义可以指向一份子组织形态，默认是中心型小组。……子组织的路由就是直做，与其他形态用的是同一条直做路由，不另写" ;
    yd:rotation yd:rm-direct ;
    yd:canSubmitCompletion yd:eg-role-center .

yd:dept-engineering yd:subOrganization yd:eg-form-center-group ;
    yd:hasInternalVerification yd:eg-vd-reviewer-center .
# NOTE: 原文说的是「职能的角色定义可以指向一份子组织形态」，指向的是角色定义；词汇里 yd:subOrganization 的主语是职能，所以挂在 yd:dept-engineering 上。

# ======================= 角色 =======================

yd:eg-role-center a yd:Role ;
    rdfs:label "工程架构师"@zh ;
    rdfs:comment "4.1 角色清单里的「中心角色」"@zh ;
    yd:archRef "4.1" ;
    yd:quote "中心角色做架构与技术设计、模块划分、起草工程计划，回答其他职能关于实现难度与成本的咨询" ;
    yd:belongsTo yd:dept-engineering ;
    yd:inForm yd:eg-form-center-group ;
    yd:receives yd:eg-src-parent-task ;
    yd:watches yd:eg-ok-design , yd:eg-ok-plan ;
    yd:produces yd:eg-ok-design , yd:eg-ok-plan , yd:eg-ok-draft , yd:eg-ok-completion ;
    yd:hasObjective yd:eg-obj-center ;
    yd:hasEvidenceBasis yd:eg-eb-project-materials , yd:eg-eb-peer-conclusions , yd:eg-eb-dept-records ;
    yd:notModeled "工具许可：询问（同伴与其他职能）、更新计划、追加说明、取消进行中的询问、查询与读取、记录、起草、交完成；可见范围：本职能可见范围；写入范围：只写自己的设计、计划或检查设计草案" .
# NOTE: 「本职能的设计、计划或检查设计」在工程里取「设计、计划」，「检查设计」属于质检，没写进来。

yd:eg-role-explorer a yd:Role ;
    rdfs:label "探索者"@zh ;
    yd:archRef "4.1" ;
    yd:quote "探索者读代码、查库与接口文档、复现问题" ;
    yd:belongsTo yd:dept-engineering ;
    yd:inForm yd:eg-form-center-group ;
    yd:hasObjective yd:eg-obj-explorer ;
    yd:hasEvidenceBasis yd:eg-eb-project-materials , yd:eg-eb-code , yd:eg-eb-external-docs ;
    yd:notModeled "关注的成果：询问里交来的查证任务（询问不是成果，词汇里没有角色接询问的属性）；写入范围：只读，不写入；工具许可：查询与读取、记录；可以几项同时进行" .
# UNSURE: 探索者的结果是对询问的回答（「回答就是它的结果」），原文没把「带来源的发现」叫成成果种类，所以没写 yd:produces。

yd:eg-role-lead a yd:Role ;
    rdfs:label "主程"@zh ;
    yd:archRef "4.1" ;
    yd:quote "主程按设计与计划实现代码并自测" ;
    yd:belongsTo yd:dept-engineering ;
    yd:inForm yd:eg-form-center-group ;
    yd:hasObjective yd:eg-obj-lead ;
    yd:hasEvidenceBasis yd:eg-eb-design-and-plan , yd:eg-eb-code , yd:eg-eb-self-test-results ;
    yd:notModeled "关注的成果：询问里交来的实现任务；写入范围：工作区（工作区只由主程写入）；工具许可：读写工作区、运行命令与自测、记录；主程可以是外包角色" .
# UNSURE: 主程「可以是外包角色」只是可能，没把它写成 yd:OutsourcedRole；它产出什么成果种类原文也没说（结果作为询问的回答交回），没写 yd:produces。

yd:eg-role-reviewer a yd:Role , yd:NoAuthorHistory ;
    rdfs:label "审查者"@zh ;
    yd:archRef "4.1" ;
    yd:quote "审查者审查设计与代码" ;
    yd:belongsTo yd:dept-engineering ;
    yd:inForm yd:eg-form-center-group ;
    yd:watches yd:eg-ok-completion , yd:eg-ok-draft ;
    yd:produces yd:eg-ok-conclusion ;
    yd:hasObjective yd:eg-obj-reviewer ;
    yd:hasEvidenceBasis yd:eg-eb-under-review , yd:eg-eb-its-basis , yd:eg-eb-prev-review ;
    yd:notModeled "可见范围：成果与依据，不含作者的历史；写入范围：检查材料，不写工作区；工具许可：读取要求、材料与证据，在独立副本上运行检查，提交结论；作为核验角色不外包；每次从新的上下文开始，先下判断再看作者的解释" .
# NOTE: yd:NoAuthorHistory 依据 4.4「看不到作者的历史」。其余三个角色原文没说看不看得到作者的历史，没归类。
# UNSURE: 审查者写的「检查材料」可能对应 yd:CheckMaterials / yd:perItemFrom，但原文没说核验每项查什么来自它，没抽。

# ======================= 来源与询问 =======================

yd:eg-src-parent-task a yd:Source ;
    rdfs:label "上一层交来的任务"@zh ;
    yd:archRef "4.2" ;
    yd:quote "子事项的来源只有「上一层交来的任务」，由中心角色接。" .
# NOTE: 和第 1 批的「上一层交来的任务」大概是同一个来源；按要求这里自己起了 IRI。

yd:eg-ask-investigation a yd:Ask ;
    rdfs:label "询问里交来的查证任务"@zh ;
    yd:archRef "4.1" ;
    yd:quote "询问里交来的查证任务" .

yd:eg-ask-implementation a yd:Ask ;
    rdfs:label "询问里交来的实现任务"@zh ;
    yd:archRef "4.1" ;
    yd:quote "询问里交来的实现任务" .

yd:eg-ask-midway-review a yd:Ask ;
    rdfs:label "工作中途询问审查者"@zh ;
    yd:archRef "4.3" ;
    yd:quote "工作中途中心角色也可以询问审查者，例如工程计划在交给主程之前先审。同样绑定版本，但只有交完成时的结论能结束子事项。" .
# NOTE: 词汇里 yd:mayAsk 只连职能与职能；角色问同伴、问审查者没有属性可写，只立了询问个体。

# ======================= 成果种类 =======================

yd:eg-ok-design a yd:OutcomeKind ;
    rdfs:label "设计"@zh ;
    yd:archRef "4.1" ;
    yd:quote "上一层交来的任务与本职能的设计、计划或检查设计" .

yd:eg-ok-plan a yd:OutcomeKind ;
    rdfs:label "计划"@zh ;
    yd:archRef "4.1" ;
    yd:quote "上一层交来的任务与本职能的设计、计划或检查设计" .

yd:eg-ok-draft a yd:OutcomeKind ;
    rdfs:label "草案"@zh ;
    yd:archRef "4.1" ;
    yd:quote "只写自己的设计、计划或检查设计草案……工作中途交来的草案" .
# UNSURE: 「草案」也许就是设计或计划的草稿版本，不是另一种成果；原文分开说了，先单列。

yd:eg-ok-completion a yd:OutcomeKind ;
    rdfs:label "中心角色交的完成"@zh ;
    yd:archRef "4.1" ;
    yd:quote "中心角色交的完成，工作中途交来的草案" ;
    yd:completion yd:completion-release .
# UNSURE: 写 yd:completion-release 依据「放行则子事项结束」；但原文也说「审查者放行只结束子事项，不是外层的放行」，这里的放行只在子事项一层。

yd:eg-ok-conclusion a yd:OutcomeKind ;
    rdfs:label "结论"@zh ;
    yd:archRef "4.3" ;
    yd:quote "结论绑定被审查那一版的内容摘要，审查后成果又改了就要再审。" .

# ======================= 目标 =======================

yd:eg-obj-center a yd:Objective ; rdfs:label "把任务做成能交完成的成果"@zh ; yd:archRef "4.1" ;
    yd:quote "把任务做成能交完成的成果" .
yd:eg-obj-explorer a yd:Objective ; rdfs:label "交回带来源的发现"@zh ; yd:archRef "4.1" ;
    yd:quote "交回带来源的发现" .
yd:eg-obj-lead a yd:Objective ; rdfs:label "按设计与计划实现并自测"@zh ; yd:archRef "4.1" ;
    yd:quote "按设计与计划实现并自测" .
yd:eg-obj-reviewer a yd:Objective ; rdfs:label "判断这一版成果是否可以放行"@zh ; yd:archRef "4.1" ;
    yd:quote "判断这一版成果是否可以放行" .

# ======================= 证据来源 =======================

yd:eg-eb-project-materials a yd:EvidenceBasis ; rdfs:label "项目材料"@zh ; yd:archRef "4.1" ;
    yd:quote "项目材料、同伴交回的结论、本职能记录……项目材料、代码、外部文档" .
yd:eg-eb-peer-conclusions a yd:EvidenceBasis ; rdfs:label "同伴交回的结论"@zh ; yd:archRef "4.1" ;
    yd:quote "项目材料、同伴交回的结论、本职能记录" .
yd:eg-eb-dept-records a yd:EvidenceBasis ; rdfs:label "本职能记录"@zh ; yd:archRef "4.1" ;
    yd:quote "项目材料、同伴交回的结论、本职能记录" .
yd:eg-eb-code a yd:EvidenceBasis ; rdfs:label "代码"@zh ; yd:archRef "4.1" ;
    yd:quote "项目材料、代码、外部文档……设计与计划、代码、自测结果" .
yd:eg-eb-external-docs a yd:EvidenceBasis ; rdfs:label "外部文档"@zh ; yd:archRef "4.1" ;
    yd:quote "项目材料、代码、外部文档" .
yd:eg-eb-design-and-plan a yd:EvidenceBasis ; rdfs:label "设计与计划"@zh ; yd:archRef "4.1" ;
    yd:quote "设计与计划、代码、自测结果" .
yd:eg-eb-self-test-results a yd:EvidenceBasis ; rdfs:label "自测结果"@zh ; yd:archRef "4.1" ;
    yd:quote "设计与计划、代码、自测结果" .
yd:eg-eb-under-review a yd:EvidenceBasis ; rdfs:label "待审查的成果"@zh ; yd:archRef "4.1" ;
    yd:quote "待审查的成果、它的依据、上一轮审查意见" .
yd:eg-eb-its-basis a yd:EvidenceBasis ; rdfs:label "它的依据"@zh ; yd:archRef "4.1" ;
    yd:quote "待审查的成果、它的依据、上一轮审查意见" .
yd:eg-eb-prev-review a yd:EvidenceBasis ; rdfs:label "上一轮审查意见"@zh ; yd:archRef "4.1" ;
    yd:quote "待审查的成果、它的依据、上一轮审查意见" .

# ======================= 小组内的核验 =======================

yd:eg-vd-reviewer-center a yd:VerificationDecl ;
    rdfs:label "审查者核验中心角色交的完成"@zh ;
    yd:archRef "4.3" ;
    yd:quote "中心角色交完成时，审查者作为核验角色核验中心角色交的这一版：产品审查需求与规格，工程审查设计与代码……放行则子事项结束；打回则中心角色再开始一轮。" ;
    yd:verifier yd:eg-role-reviewer ;
    yd:verified yd:eg-role-center ;
    yd:forOutcome yd:eg-ok-completion ;
    yd:inForm yd:eg-form-center-group .
# UNSURE: 中途审查（审查者看草案）也绑定版本，但「只有交完成时的结论能结束子事项」，没为草案另立核验声明。

# NOTE: 4.1 第二张表里产品、质检的中心角色（产品架构师、测试工程师）与分工不在这一批（只抽工程的中心型小组），没抽。
