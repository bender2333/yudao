@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix yd: <https://yudao.dev/onto#> .

yd:shape-decl-verified-produces-violation a sh:NodeShape ;
    rdfs:label "被核验者就是产出被核验成果的一方"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "被核验者就是产出被核验成果的一方"@zh ;
            sh:select """PREFIX yd: <https://yudao.dev/onto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this WHERE { $this yd:verified ?v ; yd:forOutcome ?o . ?p yd:produces ?o . FILTER NOT EXISTS { ?v yd:produces ?o } }""" ] ;
    sh:targetClass yd:VerificationDecl .

yd:shape-direct-can-complete-missing a sh:NodeShape ;
    rdfs:label "直做形态有角色能交完成"@zh ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "直做形态有角色能交完成"@zh ;
            sh:select """PREFIX yd: <https://yudao.dev/onto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this WHERE { $this yd:rotation yd:rm-direct . FILTER NOT EXISTS { $this yd:canSubmitCompletion ?r . } FILTER NOT EXISTS { $this yd:planned true } FILTER EXISTS { ?sc a yd:CommittedScope ; yd:covers yd:Form . } }""" ] ;
    sh:targetClass yd:Form .

yd:shape-direct-can-complete-unknown a sh:NodeShape ;
    rdfs:label "直做形态有角色能交完成"@zh ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "直做形态有角色能交完成"@zh ;
            sh:select """PREFIX yd: <https://yudao.dev/onto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this WHERE { $this yd:rotation yd:rm-direct . FILTER NOT EXISTS { $this yd:canSubmitCompletion ?r . } FILTER NOT EXISTS { $this yd:planned true } FILTER NOT EXISTS { ?sc a yd:CommittedScope ; yd:covers yd:Form . } }""" ] ;
    sh:targetClass yd:Form .

