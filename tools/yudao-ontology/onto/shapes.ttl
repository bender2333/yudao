yd:shape-planned-source-unknown a sh:NodeShape ;
    rdfs:label "文档写的是「以后」（写法规范第 5 条）"@zh ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "文档写的是「以后」（写法规范第 5 条）"@zh ;
            sh:select """PREFIX yd: <https://yudao.dev/onto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this WHERE { $this yd:planned true . }""" ] ;
    sh:targetClass yd:Source .

yd:shape-planned-unknown a sh:NodeShape ;
    rdfs:label "文档写的是「以后」（写法规范第 5 条）"@zh ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "文档写的是「以后」（写法规范第 5 条）"@zh ;
            sh:select """PREFIX yd: <https://yudao.dev/onto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this WHERE { $this yd:planned true . }""" ] ;
    sh:targetClass yd:Department .

yd:shape-released-has-decl-missing a sh:NodeShape ;
    rdfs:label "以放行结束的成果有核验声明"@zh ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "以放行结束的成果有核验声明"@zh ;
            sh:select """PREFIX yd: <https://yudao.dev/onto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this WHERE {  FILTER NOT EXISTS { ?d yd:forOutcome $this . } FILTER NOT EXISTS { $this yd:planned true } FILTER EXISTS { ?sc a yd:CommittedScope ; yd:covers yd:VerificationDecl . } }""" ] ;
    sh:targetClass yd:ReleasedOutcomeKind .

yd:shape-released-has-decl-unknown a sh:NodeShape ;
    rdfs:label "以放行结束的成果有核验声明"@zh ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "以放行结束的成果有核验声明"@zh ;
            sh:select """PREFIX yd: <https://yudao.dev/onto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this WHERE {  FILTER NOT EXISTS { ?d yd:forOutcome $this . } FILTER NOT EXISTS { $this yd:planned true } FILTER NOT EXISTS { ?sc a yd:CommittedScope ; yd:covers yd:VerificationDecl . } }""" ] ;
    sh:targetClass yd:ReleasedOutcomeKind .

yd:shape-seam-sides-missing a sh:NodeShape ;
    rdfs:label "每道缝写明两侧"@zh ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "每道缝写明两侧"@zh ;
            sh:select """PREFIX yd: <https://yudao.dev/onto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this WHERE {  FILTER NOT EXISTS { $this yd:side ?s1, ?s2 . FILTER(?s1 != ?s2) } FILTER NOT EXISTS { $this yd:planned true } FILTER EXISTS { ?sc a yd:CommittedScope ; yd:covers yd:Seam . } }""" ] ;
    sh:targetClass yd:Seam .

yd:shape-seam-sides-unknown a sh:NodeShape ;
    rdfs:label "每道缝写明两侧"@zh ;
