    sh:targetClass yd:Source .

yd:shape-verify-acyclic-violation a sh:NodeShape ;
    rdfs:label "谁能拒绝谁无环"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
