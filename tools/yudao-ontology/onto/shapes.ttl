yd:shape-seam-unsettled-unknown a sh:NodeShape ;
    rdfs:label "这道缝标为未定（写法规范第 5 条：未定就是不知道）"@zh ;
    sh:severity sh:Info ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "这道缝标为未定（写法规范第 5 条：未定就是不知道）"@zh ;
            sh:select """PREFIX yd: <https://yudao.dev/onto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this WHERE { $this yd:status yd:status-unsettled . }""" ] ;
    sh:targetClass yd:Seam .

yd:shape-source-received-missing a sh:NodeShape ;
    rdfs:label "每种事项的来源有人接"@zh ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "每种事项的来源有人接"@zh ;
            sh:select """PREFIX yd: <https://yudao.dev/onto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this WHERE {  FILTER NOT EXISTS { ?a yd:receives $this . } FILTER NOT EXISTS { $this yd:planned true } FILTER EXISTS { ?sc a yd:CommittedScope ; yd:covers yd:Source . } }""" ] ;
    sh:targetClass yd:Source .

