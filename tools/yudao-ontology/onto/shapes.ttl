SELECT $this WHERE {  FILTER NOT EXISTS { $this yd:status ?st . } FILTER NOT EXISTS { $this yd:planned true } FILTER EXISTS { ?sc a yd:CommittedScope ; yd:covers yd:Seam . } }""" ] ;
