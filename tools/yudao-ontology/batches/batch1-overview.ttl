# 第 1 批：总图（docs/architecture.html）。参照抽取，由本线程按总图原句逐条写出，每个个体带原句。
# 只抽方案第 6.2 节定的五处与默认三部门的方框，不抽第五、六节。
@prefix yd: <https://yudao.dev/onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

yd:fs-loop a yd:FixedStructure ; rdfs:label "循环"@zh ; yd:archRef "开头一段" ; yd:batch 1 ;
    yd:quote "固定不变的只有三样：循环、边界、裁决" .
yd:fs-boundary a yd:FixedStructure ; rdfs:label "边界"@zh ; yd:archRef "开头一段" ; yd:batch 1 ;
    yd:quote "固定不变的只有三样：循环、边界、裁决" .
yd:fs-adjudication a yd:FixedStructure ; rdfs:label "裁决"@zh ; yd:archRef "开头一段" ; yd:batch 1 ;
    yd:quote "固定不变的只有三样：循环、边界、裁决" .
yd:c-workitem a yd:Concept ; rdfs:label "事项"@zh ; yd:archRef "第二节「四层」" ; yd:batch 1 ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填部门与角色。" .
