yd:layer-facts a yd:Layer ; rdfs:label "事实与裁决"@zh ; yd:archRef "第二节「四层」" ; yd:batch 1 ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填部门与角色。" ;
    yd:recognizes yd:c-workitem, yd:c-event, yd:c-outcome-version, yd:c-proposal, yd:c-receipt, yd:c-write-scope, yd:c-limit, yd:c-decision-request ;
    yd:above yd:layer-loop .
yd:layer-loop a yd:Layer ; rdfs:label "循环"@zh ; yd:archRef "第二节「四层」" ; yd:batch 1 ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填部门与角色。" ;
    yd:recognizes yd:c-round ;
    yd:above yd:layer-routing .
yd:layer-routing a yd:Layer ; rdfs:label "路由"@zh ; yd:archRef "第二节「四层」" ; yd:batch 1 ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填部门与角色。" ;
    yd:recognizes yd:c-rotation-rules, yd:c-verifier-conclusion ;
    yd:above yd:layer-org .
yd:layer-org a yd:Layer ; rdfs:label "组织"@zh ; yd:archRef "第二节「四层」" ; yd:batch 1 ;
    yd:quote "四层：事实与裁决只认事项、事件、某种成果的某一版及其依据、提案、回执、角色的写入范围、上限与决定请求；循环只认一轮工作，谁开工、怎么结束都问路由；路由各自写轮转的规矩，核验从核验角色取；组织（定义）往里填部门与角色。" ;
    yd:recognizes yd:c-department, yd:c-role .
yd:ring-rewrite a yd:Ring ; rdfs:label "可以整体重写"@zh ; yd:archRef "第二节「什么能动」" ; yd:batch 1 ;
    yd:quote "可以整体重写路由实现、装配实现、执行实现、模型与执行环境的适配、投影、画面、观察者。重写以后外面看不出区别。" .
yd:ring-compat a yd:Ring ; rdfs:label "只能向后兼容"@zh ; yd:archRef "第二节「什么能动」" ; yd:batch 1 ;
    yd:quote "只能向后兼容三道槽位契约（路由、装配、执行）、骨架事件、对外的合同、定义的格式。字段只增，带版本。" .
yd:ring-approval a yd:Ring ; rdfs:label "只由你批准"@zh ; yd:archRef "第二节「什么能动」" ; yd:batch 1 ;
    yd:quote "只由你批准一份事实的写入口、裁决、边界、薄驱动与插件加载、评价材料、看门狗。" .
