#!/bin/sh
# GitHub App 入口（工单 #513）：gh 以 App 的安装身份运行。
# 本目录放在 PATH 最前面时生效；两个变量都没有设置时行为与原来的 gh 相同。
# 逻辑都在 yudao_github_app.py 里，这里只负责找到真正的 gh 再转过去。
# Git bash 的路径是 /d/... 形式，Python 打不开，所以用 cygpath 转成 Windows 路径；
# 真 gh 的路径可能含空格（GitHub CLI 装在 Program Files 下），候选逐行读，不用词分割。
to_windows() {
  cygpath -w "$1" 2>/dev/null || printf '%s' "$1"
}
self_dir=$(to_windows "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)")
real=""
while IFS= read -r candidate; do
  [ -n "$candidate" ] || continue
  candidate_dir=$(to_windows "$(CDPATH= cd -- "$(dirname -- "$candidate")" 2>/dev/null && pwd)")
  if [ -n "$candidate_dir" ] && [ "$candidate_dir" != "$self_dir" ]; then
    real=$(to_windows "$candidate")
    break
  fi
done <<CANDIDATES
$(which -a gh 2>/dev/null || command -v gh 2>/dev/null)
CANDIDATES
if [ -z "$real" ]; then
  echo "yudao github-app: PATH 里找不到 gh" >&2
  exit 127
fi
# 两个变量都没有设置时直接运行原来的 gh，不经 Python
if [ -z "${YUDAO_GH_APP_ID:-}" ] && [ -z "${YUDAO_GH_APP_KEY_FILE:-}" ]; then
  exec "$real" "$@"
fi
exec python "$self_dir/yudao_github_app.py" gh "$real" "$@"
